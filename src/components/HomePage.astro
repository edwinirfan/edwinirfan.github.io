---
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import { type Lang, tr, useT } from '../i18n/ui';
import { profile, stats, principles, process, experience, serviceGroups, skills } from '../data/profile';
import { projects, categoryLabels, type Category } from '../data/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const cats = Object.keys(categoryLabels) as Category[];
const counts = Object.fromEntries(cats.map((c) => [c, projects.filter((p) => p.categories.includes(c)).length]));
---
<!-- ───────────── Hero ───────────── -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="avail"><span class="pulse"></span>{t('hero.available')}</p>
      <h1>
        <span class="hello">{lang === 'id' ? 'Halo, saya' : "Hi, I'm"}</span>
        {profile.name}
      </h1>
      <p class="role-line">{tr(profile.title, lang)}</p>
      <p class="lead">{tr(profile.headline, lang)}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#projects">{t('hero.ctaProjects')} <Icon name="arrowRight" size={17} /></a>
        <a class="btn btn-ghost" href="#contact">{t('hero.ctaContact')}</a>
        <a class="btn btn-ghost" href={tr(profile.cv, lang)} download><Icon name="download" size={17} /> {t('hero.ctaPdf')}</a>
      </div>
      <ul class="hero-meta">
        <li><Icon name="pin" size={16} /> {tr(profile.location, lang)}</li>
        <li><Icon name="briefcase" size={16} /> PT ARSynergy NiX Indonesia</li>
        <li><a href={profile.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> LinkedIn</a></li>
        <li><a href={profile.github} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a></li>
      </ul>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="browser hv-desktop">
        <div class="browser-bar"><span></span><span></span><span></span></div>
        <img src="/img/partners/web-dashboard.png" alt="" fetchpriority="high" />
      </div>
      <div class="browser hv-desktop-2">
        <div class="browser-bar"><span></span><span></span><span></span></div>
        <img src="/img/carisa/dashboard.png" alt="" />
      </div>
      <div class="phone hv-phone"><img src="/img/arsygas/beranda.png" alt="" /></div>
      <div class="float f1"><Icon name="check" size={15} /> Play Store & App Store</div>
      <div class="float f2"><Icon name="check" size={15} /> 460+ {lang === 'id' ? 'test otomatis' : 'automated tests'}</div>
      <div class="float f3"><Icon name="rfid" size={15} /> ~60K RFID + NFC</div>
    </div>
  </div>

  <div class="container">
    <dl class="stats">
      {
        stats.map((s) => (
          <div class="stat reveal">
            <dt>{s.value}</dt>
            <dd>{tr(s.label, lang)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<!-- ───────────── About ───────────── -->
<section class="section" id="about">
  <div class="container about">
    <div class="reveal">
      <span class="eyebrow">{lang === 'id' ? 'Tentang Saya' : 'About Me'}</span>
      <h2 class="about-title">{lang === 'id' ? 'Developer yang memegang proyek dari hulu ke hilir.' : 'A developer who owns projects end to end.'}</h2>
      <p class="about-text">{tr(profile.about, lang)}</p>
    </div>
    <ul class="principles">
      {
        principles.map((p) => (
          <li class="card principle reveal">
            <span class="p-icon"><Icon name={p.icon} size={20} /></span>
            <h3>{tr(p.title, lang)}</h3>
            <p>{tr(p.body, lang)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ───────────── Projects ───────────── -->
<section class="section" id="projects">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t('projects.eyebrow')}</span>
      <h2>{t('projects.title')}</h2>
      <p>{t('projects.subtitle')}</p>
    </div>

    <div class="filters" role="toolbar" aria-label="Filter">
      <button type="button" class="filter active" data-filter="all" aria-pressed="true">
        {t('projects.all')} <span>{projects.length}</span>
      </button>
      {
        cats.map((c) => (
          <button type="button" class="filter" data-filter={c} aria-pressed="false">
            {tr(categoryLabels[c], lang)} <span>{counts[c]}</span>
          </button>
        ))
      }
    </div>

    <div class="project-grid">
      {projects.map((p, i) => <ProjectCard project={p} lang={lang} featured={i === 0} />)}
    </div>
  </div>
</section>

<!-- ───────────── Experience ───────────── -->
<section class="section" id="experience">
  <div class="container exp-grid">
    <div class="section-head reveal sticky-head">
      <span class="eyebrow">{t('experience.eyebrow')}</span>
      <h2>{t('experience.title')}</h2>
      <p>
        {
          lang === 'id'
            ? 'Dari IT support hingga Full-Stack Developer di industri energi (LPG), ditambah proyek freelance sejak 2023.'
            : 'From IT support to Full-Stack Developer in the energy (LPG) industry, plus freelance projects since 2023.'
        }
      </p>
    </div>
    <ol class="timeline">
      {
        experience.map((e) => (
          <li class="reveal">
            <span class="dot" />
            <div class="t-period">{tr(e.period, lang)}</div>
            <h3>{tr(e.role, lang)}</h3>
            <div class="t-org">{e.org} <span>· {tr(e.location, lang)}</span></div>
            {e.body && <p class="t-body">{tr(e.body, lang)}</p>}
            <ul class="t-points">
              {e.points[lang].map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ───────────── Process ───────────── -->
<section class="section process-section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t('process.eyebrow')}</span>
      <h2>{t('process.title')}</h2>
    </div>
    <ol class="process">
      {
        process.map((s, i) => (
          <li class="reveal">
            <span class="step">{String(i + 1).padStart(2, '0')}</span>
            <h3>{tr(s.title, lang)}</h3>
            <p>{tr(s.body, lang)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ───────────── Services ───────────── -->
<section class="section" id="services">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t('services.eyebrow')}</span>
      <h2>{t('services.title')}</h2>
      <p>{t('services.subtitle')}</p>
    </div>
    {
      serviceGroups.map((g, gi) => (
        <div class="s-group">
          <h3 class="s-group-title reveal">
            <span>{String(gi + 1).padStart(2, '0')}</span>
            {tr(g.title, lang)}
          </h3>
          <ul class="services">
            {g.items.map((s) => (
              <li class="card service reveal">
                <div class="s-head">
                  <span class="s-icon">
                    <Icon name={s.icon} size={20} />
                  </span>
                  <h4>{tr(s.title, lang)}</h4>
                </div>
                <p>{tr(s.body, lang)}</p>
                {s.ref && <span class="s-ref">{s.ref}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="s-cta card reveal">
      <div>
        <h3>{lang === 'id' ? 'Kebutuhan Anda tidak ada di daftar?' : "Don't see what you need?"}</h3>
        <p>
          {
            lang === 'id'
              ? 'Saya terbuka untuk berbagai jenis proyek freelance, baik proyek baru dari nol, melanjutkan aplikasi yang sudah ada, maupun pekerjaan jangka pendek. Ceritakan kebutuhan Anda, dan kita diskusikan solusinya.'
              : "I'm open to all kinds of freelance work, whether it's a new build from scratch, taking over an existing app, or a short-term job. Tell me what you need and we'll work out a solution."
          }
        </p>
      </div>
      <div class="s-cta-actions">
        <a
          class="btn btn-primary"
          href={`https://wa.me/${profile.whatsapp}?text=${encodeURIComponent(lang === 'id' ? 'Halo Edwin, saya ingin diskusi proyek: ' : "Hi Edwin, I'd like to discuss a project: ")}`}
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={17} /> {lang === 'id' ? 'Diskusi via WhatsApp' : 'Chat on WhatsApp'}
        </a>
        <a class="btn btn-ghost" href={`mailto:${profile.email}?subject=${encodeURIComponent(lang === 'id' ? 'Diskusi proyek freelance' : 'Freelance project inquiry')}`}>
          <Icon name="mail" size={17} /> Email
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ───────────── Skills ───────────── -->
<section class="section" id="skills">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t('skills.eyebrow')}</span>
      <h2>{t('skills.title')}</h2>
    </div>
    <div class="skills">
      {
        skills.map((g) => (
          <div class="card skill-group reveal">
            <h3>{tr(g.group, lang)}</h3>
            <ul>
              {g.items.map((s) => (
                <li class="chip">{typeof s === 'string' ? s : tr(s, lang)}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ───────────── Contact ───────────── -->
<section class="section" id="contact">
  <div class="container">
    <div class="contact card reveal">
      <div class="contact-copy">
        <span class="eyebrow">{t('contact.eyebrow')}</span>
        <h2>{t('contact.title')}</h2>
        <p>{t('contact.subtitle')}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={`mailto:${profile.email}`}><Icon name="mail" size={17} /> {t('contact.email')}</a>
          <a class="btn btn-ghost" href={`https://wa.me/${profile.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={17} /> {t('contact.whatsapp')}</a>
        </div>
      </div>
      <ul class="contact-list">
        <li>
          <span class="c-icon"><Icon name="mail" size={18} /></span>
          <div><small>{t('contact.email')}</small><a href={`mailto:${profile.email}`}>{profile.email}</a></div>
        </li>
        <li>
          <span class="c-icon"><Icon name="whatsapp" size={18} /></span>
          <div><small>{t('contact.whatsapp')}</small><a href={`https://wa.me/${profile.whatsapp}`} target="_blank" rel="noopener">{profile.whatsappDisplay}</a></div>
        </li>
        <li>
          <span class="c-icon"><Icon name="linkedin" size={18} /></span>
          <div><small>LinkedIn</small><a href={profile.linkedin} target="_blank" rel="noopener">linkedin.com/in/edwinirfan</a></div>
        </li>
        <li>
          <span class="c-icon"><Icon name="github" size={18} /></span>
          <div><small>{t('contact.github')}</small><a href={profile.github} target="_blank" rel="noopener">github.com/edwinirfan</a></div>
        </li>
        <li>
          <span class="c-icon"><Icon name="pin" size={18} /></span>
          <div><small>{t('contact.location')}</small><span>{tr(profile.location, lang)}</span></div>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('.project-grid .project-card');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => {
        x.classList.toggle('active', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
      cards.forEach((c) => {
        const show = f === 'all' || c.dataset.categories!.split(' ').includes(f);
        c.hidden = !show;
        if (show) c.classList.add('in');
      });
      document.querySelector('.project-grid')!.classList.toggle('filtered', f !== 'all');
    }),
  );
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-top: 56px;
    padding-bottom: 72px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 85% 10%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%),
      radial-gradient(40% 40% at 0% 30%, color-mix(in srgb, #6366f1 12%, transparent), transparent 70%),
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 32px 32px;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-2);
  }
  .pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 var(--ok);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 9px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  h1 {
    margin-top: 22px;
    font-size: clamp(36px, 6vw, 60px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .hello {
    display: block;
    font-size: 0.42em;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }
  .role-line {
    margin-top: 14px;
    font-size: clamp(18px, 2.4vw, 22px);
    font-weight: 700;
    background: linear-gradient(90deg, var(--accent), #f43f5e);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .lead {
    margin-top: 16px;
    font-size: 17.5px;
    color: var(--text-2);
    max-width: 560px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .hero-meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 14px;
  }
  .hero-meta li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-visual {
    position: relative;
    aspect-ratio: 1 / 0.82;
    max-width: 560px;
    width: 100%;
    margin-inline: auto;
  }
  .hv-desktop {
    position: absolute;
    left: 0;
    top: 6%;
    width: 86%;
    transform: rotate(-2deg);
  }
  .hv-desktop-2 {
    position: absolute;
    left: 16%;
    top: 46%;
    width: 64%;
    transform: rotate(2.5deg);
  }
  .hv-phone {
    position: absolute;
    right: 0;
    top: 14%;
    width: 30%;
    border-radius: 24px;
    padding: 5px;
    animation: float 6s ease-in-out infinite;
  }
  .hv-phone img {
    border-radius: 19px;
  }
  .float {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    white-space: nowrap;
  }
  .float :global(svg) {
    color: var(--ok);
  }
  .f1 {
    left: -2%;
    top: -2%;
  }
  .f2 {
    right: 2%;
    bottom: 4%;
  }
  .f3 {
    left: 2%;
    bottom: 12%;
  }
  .f3 :global(svg) {
    color: #06b6d4;
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
  @media (min-width: 980px) {
    .hero {
      padding-top: 80px;
    }
    .hero-grid {
      grid-template-columns: 1.05fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .float {
      font-size: 11px;
      padding: 5px 9px;
    }
    .f3 {
      display: none;
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 56px 0 0;
  }
  .stat {
    padding: 20px;
    border-radius: var(--radius);
    background: var(--bg-elev);
    border: 1px solid var(--border);
  }
  .stat dt {
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .stat dd {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 14px;
  }
  @media (min-width: 800px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* About */
  .about {
    display: grid;
    gap: 40px;
  }
  .about-title {
    margin-top: 10px;
    font-size: clamp(26px, 3.6vw, 36px);
    font-weight: 800;
  }
  .about-text {
    margin-top: 18px;
    color: var(--text-2);
    font-size: 16.5px;
  }
  .principles {
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .principle {
    padding: 22px;
  }
  .principle h3 {
    font-size: 17px;
    margin-top: 14px;
  }
  .principle p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14.5px;
  }
  .p-icon,
  .s-icon,
  .c-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  @media (min-width: 640px) {
    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 980px) {
    .about {
      grid-template-columns: 1fr 1.15fr;
      gap: 56px;
      align-items: start;
    }
  }

  /* Projects */
  .filters {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 6px;
    margin-bottom: 24px;
    scrollbar-width: none;
  }
  .filters::-webkit-scrollbar {
    display: none;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding-inline: 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text-2);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .filter span {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .filter:hover {
    border-color: var(--border-strong);
  }
  .filter.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .filter.active span {
    color: inherit;
    opacity: 0.7;
  }
  .project-grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 760px) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Experience */
  .exp-grid {
    display: grid;
    gap: 8px;
  }
  @media (min-width: 980px) {
    .exp-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
    }
    .sticky-head {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    border-left: 2px solid var(--border);
    margin-left: 6px;
  }
  .timeline > li {
    position: relative;
    padding: 0 0 40px 28px;
  }
  .timeline > li:last-child {
    padding-bottom: 0;
  }
  .dot {
    position: absolute;
    left: -8px;
    top: 4px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--accent);
  }
  .t-period {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--accent);
    font-weight: 500;
  }
  .timeline h3 {
    margin-top: 6px;
    font-size: 20px;
  }
  .t-org {
    font-weight: 600;
    color: var(--text-2);
    margin-top: 2px;
  }
  .t-org span {
    font-weight: 500;
    color: var(--muted);
  }
  .hero-meta a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-meta a:hover {
    color: var(--accent);
  }
  .t-body {
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
  }
  .t-points {
    margin-top: 12px;
    display: grid;
    gap: 8px;
    padding-left: 18px;
    color: var(--text-2);
    font-size: 15px;
  }
  .t-points li::marker {
    color: var(--accent);
  }

  /* Process */
  .process {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
    counter-reset: step;
  }
  .process li {
    position: relative;
    padding: 22px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .step {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
  }
  .process h3 {
    margin-top: 8px;
    font-size: 18px;
  }
  .process p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14.5px;
