---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, localePath } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page without the language prefix, e.g. "/" or "/projects/carisa/". */
  path: string;
  ogImage?: string;
}

const { lang, title, description, path, ogImage = '/og.png' } = Astro.props;
const site = Astro.site ?? new URL('https://edwinirfan.github.io');
const canonical = new URL(localePath(lang, path), site).href;
const altId = new URL(localePath('id', path), site).href;
const altEn = new URL(localePath('en', path), site).href;
const og = new URL(ogImage, site).href;
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={altId} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altId} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0e17" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fb" media="(prefers-color-scheme: light)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'id' ? 'Lewati ke konten' : 'Skip to content'}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <dialog class="lightbox" id="lightbox" aria-label="Image preview">
      <button class="lightbox-close" type="button" aria-label="Close">✕</button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
    </dialog>

    <script>
      // Theme toggle
      const root = document.documentElement;
      const currentTheme = () =>
        root.getAttribute('data-theme') ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = currentTheme() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch {}
        });
      });

      // Reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Lightbox
      const box = document.getElementById('lightbox') as HTMLDialogElement;
      const boxImg = box.querySelector('img')!;
      const boxCap = box.querySelector('figcaption')!;
      document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((el) => {
        el.addEventListener('click', () => {
          boxImg.src = el.dataset.zoom!;
          boxImg.alt = el.dataset.caption ?? '';
          boxCap.textContent = el.dataset.caption ?? '';
          box.classList.toggle('is-diagram', el.dataset.kind === 'diagram');
          box.showModal();
        });
      });
      box.addEventListener('click', (e) => {
        if (e.target === box || (e.target as HTMLElement).closest('.lightbox-close')) box.close();
      });
    </script>
  </body>
</html>

<style is:global>
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(1200px, 94vw);
    max-height: 92vh;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(5 8 14 / 0.82);
    backdrop-filter: blur(4px);
  }
  .lightbox figure {
    margin: 0;
    display: grid;
    gap: 12px;
    justify-items: center;
  }
  .lightbox img {
    max-height: 82vh;
    width: auto;
    max-width: 100%;
    border-radius: 12px;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.6);
  }
  .lightbox.is-diagram img {
    background: #fff;
    padding: 12px;
  }
  .lightbox figcaption {
    color: #e8edf5;
    font-size: 14px;
  }
  .lightbox-close {
    position: absolute;
    top: -44px;
    right: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
  }
</style>
